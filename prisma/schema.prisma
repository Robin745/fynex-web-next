// Multi-tenant Dollar Buy & Sell (FX Operations) Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         String             @default("CLIENT_USER") // "SUPERADMIN" | "CLIENT_USER"
  status       String             @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  TenantMembership[]
  transactions Transaction[]
  auditLogs    AuditLog[]
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  status             String             @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  contactEmail       String
  contactPhone       String?
  clientType         String             @default("EXPORTER") // "EXPORTER", "IMPORTER", "DUAL_TRADER"
  settlementCurrency String             @default("BDT") // Local currency for settlements (e.g. BDT ৳)
  defaultBuyRate     Float              @default(121.50) // Benchmark Buy rate (Admin buys USD from client)
  defaultSellRate    Float              @default(122.80) // Benchmark Sell rate (Admin sells USD to client)
  platformFeePercent Float              @default(0.5) // Baseline margin %
  currency           String             @default("USD")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  memberships        TenantMembership[]
  dailyRecords       DailyRecord[]
  transactions       Transaction[]
  auditLogs          AuditLog[]
}

model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("CLIENT_ADMIN") // "CLIENT_ADMIN" | "CLIENT_VIEWER"
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model DailyRecord {
  id                    String        @id @default(cuid())
  tenantId              String
  date                  String        // Format: YYYY-MM-DD
  usdBought             Float         @default(0.0) // USD bought from client (Client sells USD)
  buyRate               Float         @default(0.0) // Average buy rate
  usdSold               Float         @default(0.0) // USD sold to client (Client buys USD)
  sellRate              Float         @default(0.0) // Average sell rate
  totalUsdVolume        Float         @default(0.0) // usdBought + usdSold
  totalSettlementAmount Float         @default(0.0) // (usdBought * buyRate) + (usdSold * sellRate) in settlement currency
  netUsdFlow            Float         @default(0.0) // usdBought - usdSold
  netProfit             Float         @default(0.0) // Admin spread profit earned
  marginPercentage      Float         @default(0.0)
  status                String        @default("SETTLED") // "SETTLED" | "PENDING"
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([tenantId, date])
}

model Transaction {
  id                 String       @id @default(cuid())
  tenantId           String
  dailyRecordId      String?
  tradeNumber        String?      // e.g. "FX-202611-001"
  type               String       // "BUY_USD" (client sells USD to FynEX) | "SELL_USD" (client buys USD from FynEX)
  usdAmount          Float        // Volume in USD ($)
  exchangeRate       Float        // Rate applied per dollar (e.g. 122.00)
  settlementAmount   Float        // Total payout or payment in local currency (usdAmount * exchangeRate)
  settlementCurrency String       @default("BDT")
  paymentMethod      String       @default("Bank Wire") // "Bank Wire", "Cash Settlement", "Payoneer / Wise", "Crypto USDT"
  paymentStatus      String       @default("COMPLETED") // "COMPLETED" | "PENDING"
  category           String       @default("Trade") // "Export Settlement", "Import Purchase", "Contract Payout", "Other"
  description        String
  reference          String?      // Bank transfer number, MT103 reference, voucher
  date               String       // Format: YYYY-MM-DD
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyRecord DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String   // "CREATE_DOLLAR_TRADE", "BATCH_ENTRY", "EDIT_TRADE", "DELETE_TRADE", "UPDATE_CLIENT"
  entityType String
  entityId   String?
  details    String?  // JSON string
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}
